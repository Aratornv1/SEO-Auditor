{
    "name": "aratornv1/seo-checker",
    "description": "Extensible command-line SEO auditor for web pages, written in plain PHP (Strategy pattern).",
    "type": "library",
    "license": "MIT",
    "keywords": ["seo", "audit", "cli", "strategy-pattern"],
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-curl": "Preferred HTTP transport (gzip support, strict protocol restrictions); PHP streams are used as a fallback"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Aratornv1\\SeoChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aratornv1\\SeoChecker\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/seo-check"],
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "lint": "Check PSR-12 code style (phpcs.xml.dist)",
        "analyse": "Run PHPStan static analysis (phpstan.neon.dist)",
        "check": "Run code style, static analysis and tests"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
