#!/usr/bin/env php
<?php

declare(strict_types=1);

use Aratornv1\SeoChecker\Analyzer;
use Aratornv1\SeoChecker\Cli;

// Locate the Composer autoloader: either this package is the root project,
// or it is installed as a dependency inside another project's vendor/.
$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

if (!class_exists(Analyzer::class)) {
    fwrite(STDERR, "Composer autoloader not found. Run `composer install` first." . PHP_EOL);
    // A literal code: without the autoloader the Cli class (and its constants) cannot be loaded.
    exit(2);
}

// --- Terminal setup ----------------------------------------------------------
$isTty = function_exists('stream_isatty') && stream_isatty(STDOUT);

if (PHP_OS_FAMILY === 'Windows' && $isTty) {
    // Switch the console to UTF-8 and enable ANSI escape sequences.
    if (function_exists('sapi_windows_cp_set')) {
        sapi_windows_cp_set(65001);
    }
    if (function_exists('sapi_windows_vt100_support')) {
        sapi_windows_vt100_support(STDOUT, true);
    }
}

// Colors only make sense on a real terminal and when NO_COLOR is not set.
$colorAllowed = $isTty && getenv('NO_COLOR') === false;

exit((new Cli(colorAllowed: $colorAllowed))->run(array_slice($argv, 1)));
